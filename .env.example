PORT=5000
NODE_ENV=development

DATABASE_URL=postgres://billing_user:billing_pass@localhost:5434/restaurant_billing

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1d

FRONTEND_URL=http://localhost:3000

UPLOAD_DIR=public/uploads
BILL_NUMBER_PREFIX=INV

# Optional: point PDF generation at a system-installed Chromium (e.g.
# /usr/bin/chromium-browser) instead of puppeteer's bundled download.
PUPPETEER_EXECUTABLE_PATH=

SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe123!
