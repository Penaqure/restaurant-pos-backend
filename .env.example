PORT=5000
NODE_ENV=development

DATABASE_URL=postgres://billing_user:billing_pass@localhost:5434/restaurant_billing

# Only set to "true" if DATABASE_URL points at a Postgres that terminates TLS
# itself (e.g. a managed/remote instance reached over an untrusted network).
# Leave "false" for the bundled docker-compose postgres service, which
# doesn't have SSL enabled -- setting this to true there breaks every DB
# connection. See config/config.js for details.
DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=false   # only if DB_SSL=true and the server's cert has no CA this app trusts

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# The server refuses to start with this placeholder, or anything under 32 chars.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1d

FRONTEND_URL=http://localhost:3000

# Cookie set on login is not marked Secure by default -- this LAN deployment
# (see docker-compose.yml) is plain HTTP, and a Secure cookie is silently
# dropped by browsers over HTTP. Set to "true" only once this is served over
# HTTPS (e.g. behind a reverse proxy terminating TLS).
COOKIE_SECURE=false

UPLOAD_DIR=public/uploads
BILL_NUMBER_PREFIX=INV

# A full DB backup (pg_dump, custom format) runs automatically on startup
# and every 24h after -- written to backups/, oldest pruned beyond the
# retention count. Set BACKUP_ENABLED=false to turn it off entirely.
BACKUP_ENABLED=true
BACKUP_RETENTION_COUNT=7

# Optional: point PDF generation at a system-installed Chromium (e.g.
# /usr/bin/chromium-browser) instead of puppeteer's bundled download.
PUPPETEER_EXECUTABLE_PATH=

# Optional: a networked kitchen ticket printer. When enabled, a KOT prints
# automatically the moment an order is placed or items are added to one --
# no manual "Print KOT" click needed. Works with any ESC/POS-compatible
# printer (the overwhelming majority of thermal receipt/kitchen printers,
# Epson-badged or not) reachable on the LAN; raw/direct printing, not a
# driver install on this machine. Leave KITCHEN_PRINTER_ENABLED=false if
# there's no such printer -- this never blocks order placement either way,
# even if the printer is unreachable.
KITCHEN_PRINTER_ENABLED=false
KITCHEN_PRINTER_IP=
KITCHEN_PRINTER_PORT=9100

SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe123!
